{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(admin|pelatih)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/menu.js": {
      "includeFiles": "data/**",
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/google.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/google/:action",
      "destination": "/api/google?action=:action"
    }
  ]
}